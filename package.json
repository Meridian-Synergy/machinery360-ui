{
  "name": "machinery360-ui",
  "version": "0.8.0",
  "description": "Machinery360 design system — shared UI library (Vue 3 + Storybook)",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens/*": "./src/tokens/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build-storybook"
  },
  "license": "UNLICENSED",
  "private": false,
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@nuxt/eslint-config": "^1.16.0",
    "@storybook/addon-a11y": "^10.2.15",
    "@storybook/addon-docs": "^10.2.15",
    "@storybook/vue3": "^10.2.15",
    "@storybook/vue3-vite": "^10.2.15",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.7.0",
    "flag-icons": "^7.5.0",
    "happy-dom": "^20.0.0",
    "storybook": "^10.2.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue": "^3.5.29",
    "vue-tsc": "^3.2.5"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
